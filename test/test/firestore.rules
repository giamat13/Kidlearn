rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The profile fields a user may store; anything else is refused.
    // grade: the same keys as "grade" in games.json and the sign-up select (preschool ... twelfth)
    function isValidProfile(data) {
      return data.keys().hasOnly(['username', 'displayName', 'grade', 'createdAt', 'avatarEmoji', 'recoveryEmail'])
        && (!('username' in data) || (data.username is string && data.username.matches('^[a-z0-9_]{3,20}$')))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30))
        && (!('grade' in data) || (data.grade is string && data.grade in ['preschool', 'kindergarten', 'first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'tenth', 'eleventh', 'twelfth']))
        && (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 16))
        && (!('recoveryEmail' in data) || (data.recoveryEmail is string && data.recoveryEmail.size() <= 254));
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // A new profile must carry the name and grade chosen at sign-up
      allow create: if request.auth != null && request.auth.uid == uid
                      && isValidProfile(request.resource.data)
                      && 'displayName' in request.resource.data && 'grade' in request.resource.data;
      // Profiles created before name and grade existed can still be updated (avatar, recovery email)
      allow update: if request.auth != null && request.auth.uid == uid
                      && isValidProfile(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /saves/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // One document per game the parent switched off: { off: true }. No document = the game is on.
      match /gameSettings/{gameId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                       && request.resource.data.keys().hasOnly(['off'])
                       && request.resource.data.off is bool;
      }
    }

    match /messages/{messageId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.fromUid == request.auth.uid;
      // `image` is a base64 data URL embedded directly in the doc (no Cloud Storage
      // bucket - this project stays on the free Spark plan), capped well under
      // Firestore's 1MB document limit so a bypassed/oversized client write can't
      // blow out the doc.
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid
                      && (!('image' in request.resource.data) || request.resource.data.image == null
                          || request.resource.data.image.size() < 700000);
      allow delete: if false;
      // `thread` carries every message after the first reply (see reply.html) -
      // an anonymous family member can only ever append to this array field on
      // a message doc they already know the id of (via their emailed link),
      // never touch the kid-authored body/subject/fromUid/toEmail.
      // A thread entry may carry its own base64 `image`, exactly like the kid's
      // `image` above. Per-element sizes aren't checkable here, so reply.html
      // downscales and refuses an attachment that would push the doc past ~900KB;
      // Firestore's own 1MB document limit is the hard backstop.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['replyBody', 'repliedAt', 'replied', 'replySeenByKid', 'thread']);
    }
  }
}
