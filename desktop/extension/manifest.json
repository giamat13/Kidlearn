{
  "manifest_version": 3,
  "name": "Kidlearn",
  "version": "1.3.0",
  "description": "כל טאב חדש נפתח באתר Kidlearn, והאתר מדבר עם האפליקציה במחשב",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge-content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
