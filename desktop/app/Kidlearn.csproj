<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Kidlearn</AssemblyName>
    <RootNamespace>Kidlearn.Tray</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\kidlearn.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- Without this, ProductVersion carries the git commit hash after a "+" -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Framework-dependent single exe. Self-contained measured ~107 MB working set (~46 MB private)
    when idle; framework-dependent measured ~43 MB working set (~10 MB private). The installer
    makes sure the .NET 10 Desktop Runtime is present before the app is started.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serial port access for the micro:bit installer (not part of the shared framework) -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\kidlearn.ico" LogicalName="kidlearn.ico" />
    <Compile Include="..\shared\NativeMessaging.cs" Link="Shared\NativeMessaging.cs" />
  </ItemGroup>

</Project>
